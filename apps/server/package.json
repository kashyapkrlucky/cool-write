    "@prisma/client": "^7.9.1",
    "@repo/ui": "*",
    "dotenv": "^16.0.3",
    "eslint-plugin-react": "7.22.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^10.8.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.2"
  }
