# Copy to `.env` and fill in. Validated at startup by src/server/env.ts —
# missing required values fail fast with a list of what's wrong.

# --- Required -----------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cool_write"

# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
# (NEXTAUTH_SECRET is accepted as a fallback name.)
AUTH_SECRET=""

# Public URL of the app; NextAuth uses it to build OAuth callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI chat --------------------------------------------------------------------

# Without a key the app works, but the Ask AI panel returns an error.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Per-user limits on AI chat requests (defaults shown).
# AI_REQUESTS_PER_MINUTE=10
# AI_REQUESTS_PER_DAY=200

# --- Desktop app downloads ---------------------------------------------------

# Local driver (default): builds are served from this directory (default ./files),
# filled by `npm run stage` in desktop/. Works in dev and on hosts with a disk.
# DESKTOP_RELEASES_DIR="./files"

# Remote driver: required on Vercel (no persistent disk). Upload the files/ tree
# somewhere public (e.g. a GitHub releases repo) and point this at its base URL;
# download links then redirect there.
# DESKTOP_RELEASES_URL="https://downloads.example.com"
